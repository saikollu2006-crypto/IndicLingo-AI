# IndicLingo AI Backend Environment Configuration

# Server
HOST=127.0.0.1
PORT=8000
DEBUG=True
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Storage Paths
STORAGE_DIR=storage
UPLOAD_DIR=storage/uploads
AUDIO_DIR=storage/generated_audio
DOC_DIR=storage/documents
TEMP_DIR=storage/temp

# Model Paths & Devices (auto, cpu, cuda)
DEVICE=auto
NLLB_MODEL_ID=facebook/nllb-200-distilled-600M
WHISPER_MODEL_SIZE=tiny
TTS_PROVIDER=edge_tts
MAX_INPUT_CHARS=10000
MAX_UPLOAD_MB=25

# Database
DATABASE_URL=sqlite:///./storage/indiclingo.db
